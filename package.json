{
  "name": "xb-api",
  "description": "",
  "version": "1.0.0",
  "main": "dist/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "ts-node-dev -r dotenv/config src/server.ts",
    "dev:staging": "cross-env NODE_ENV=preview ts-node-dev -r dotenv/config src/server.ts",
    "start": "cross-env NODE_ENV=production node -r dotenv/config dist/server.js",
    "start:staging": "cross-env NODE_ENV=preview node -r dotenv/config dist/server.js",
    "ts-lint": "tsc --noEmit",
    "format": "prettier --write .",
    "build": "tsc -p .",
    "migrate:ratings": "ts-node-dev --transpile-only --exit-child -r dotenv/config src/scripts/migrateBookRatings.ts",
    "prepare": "husky install || true"
  },
  "lint-staged": {
    "*.{ts,json}": [
      "npm run format"
    ]
  },
  "keywords": [],
  "author": "Franco Andrés Sánchez",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "7.120.4",
    "@sentry/tracing": "7.120.4",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cookie-session": "2.0.49",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.1.0",
    "@types/node": "25.9.1",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-dist": "3.30.6",
    "@types/swagger-ui-express": "4.1.8",
    "cache-manager": "5.7.6",
    "cloudinary": "2.10.0",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "express-rate-limit": "8.5.2",
    "firebase-admin": "13.10.0",
    "helmet": "8.2.0",
    "ioredis": "5.11.1",
    "mongoose": "8.17.0",
    "morgan": "1.11.0",
    "multer": "2.1.1",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.8.3",
    "ts-node-dev": "2.0.0"
  }
}
